# Project Peptides — environment variables (production target)
# The demo runs with NONE of these; it uses in-memory mock data.

# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/project_peptides?schema=public"

# Authentication (choose one provider; wire via src/lib/auth.ts AuthAdapter)
# Auth0
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Billing (Stripe — abstraction only; not charged in MVP)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Pharmacy integrations (per-adapter; none connected in MVP)
# PHARMACY_A_API_KEY=""
